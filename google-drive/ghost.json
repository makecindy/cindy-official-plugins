{
  "schemaVersion": 2,
  "id": "google-drive",
  "name": "Google Drive",
  "description": "独立连接 Google Drive：搜索、读取、下载、上传、移动和删除云端文件。只申请 Drive 所需权限，授权与令牌由主机托管。",
  "whenToUse": "需要搜索或管理 Google Drive、Docs、Slides 文件时使用。请先在本插件详情页单独连接 Google Drive 账号。",
  "version": "1.1.2",
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json"
  },
  "author": "Cindy",
  "icon": "assets/icon.png",
  "entry": "main.js",
  "settingsHtml": "settings.html",
  "slots": ["tool", "network"],
  "command": "google-drive",
  "network": {
    "hosts": [
      "accounts.google.com",
      "oauth2.googleapis.com",
      "www.googleapis.com"
    ],
    "secrets": [
      {
        "key": "google_drive_account",
        "label": "Google Drive 账号",
        "source": "oauth",
        "hint": "只授权 Google Drive 权限；到本插件详情页点「连接账号」完成授权",
        "inject": {
          "header": "Authorization",
          "format": "Bearer {value}",
          "hosts": ["www.googleapis.com"]
        },
        "oauth": {
          "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
          "tokenUrl": "https://oauth2.googleapis.com/token",
          "clientId": "966060737739-d3dfjdsaace1ur4thk03h3aj4hpnjucq.apps.googleusercontent.com",
          "clientSecret": "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",
          "scopes": [
            "openid",
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/drive"
          ],
          "pkce": true,
          "extraAuthorizeParams": {
            "access_type": "offline",
            "prompt": "consent"
          },
          "identity": {
            "url": "https://www.googleapis.com/oauth2/v3/userinfo",
            "labelPath": "email"
          }
        }
      }
    ]
  },
  "tools": [
    {
      "name": "google_drive_accounts",
      "description": "列出本插件已连接的 Google Drive 账号及状态。账号必须先在 Google Drive 插件详情页单独授权。",
      "parameters": { "type": "object", "properties": {} }
    },
    {
      "name": "google_drive",
      "description": "执行 Google Drive 操作：search、list_folder、get_meta、read、download、upload、move、delete。search 默认把 query 当文件名片段；只有显式传 query_mode=raw 才按 Drive 查询语法发送。download 需要调用方通过 ghost_call 顶层 save_dir 提供落盘目录，主机据此注入 save_deposit。删除、覆盖、移动和上传属于写操作，必须有用户明确意图。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["search", "list_folder", "get_meta", "read", "download", "upload", "move", "delete"]
          },
          "account": { "type": "string", "description": "账号 id；省略使用本插件默认账号" },
          "query": { "type": "string", "description": "搜索词；默认按文件名片段匹配，query_mode=raw 时按 Drive 查询语法发送" },
          "query_mode": { "type": "string", "enum": ["name", "raw"], "description": "search 查询模式，默认 name；raw 表示显式使用 Drive 查询语法" },
          "max_results": { "type": "number" },
          "file_id": { "type": "string" },
          "folder_id": { "type": "string" },
          "export_mime": { "type": "string" },
          "filename": { "type": "string" },
          "name": { "type": "string" },
          "content": { "type": "string" },
          "mime_type": { "type": "string" },
          "parent_folder_id": { "type": "string" },
          "new_parent_id": { "type": "string" },
          "new_name": { "type": "string" },
          "permanent": { "type": "boolean" }
        },
        "required": ["action"]
      }
    }
  ]
}
