{
  "schemaVersion": 3,
  "minCindyVersion": "0.1.112",
  "id": "outlook-mail",
  "name": "Outlook 邮箱",
  "description": "搜索、阅读、起草、回复、发送和整理 Outlook 与 Microsoft 365 邮件；写信和回复使用 Cindy 可编辑草稿卡，发送前可撤销。通过 Cindy 托管 OAuth 授权和令牌注入访问 Microsoft Graph；首次使用请在插件详情页连接账号。",
  "whenToUse": "需要连接 Outlook、Hotmail、Live 或 Microsoft 365 企业邮箱，查询、阅读、发送、起草或整理邮件时使用，包括世纪互联中国区微软托管邮箱。",
  "version": "2.3.0",
  "kind": "chip",
  "entry": "main.js",
  "icon": "assets/icon.png",
  "tools": [
    {
      "name": "outlook_accounts",
      "description": "同时列出全球版和世纪互联中国区的已连接账号、各区默认账号及应用配置状态。支持多账号同时登录；可传 profile_account，通过只读 Graph 查询该账号的 mail 与 user_principal_name。登录名不一定是收信地址，mail 为空时不要猜测。不读取邮件、不返回令牌。",
      "parameters": {
        "type": "object",
        "properties": {
          "profile_account": {
            "type": "string",
            "description": "可选：本工具返回的账号 ID。仅指定时只读查询该账号的 Graph mail（可能为空）与 user_principal_name；不得把登录名自动当作收信地址。",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "outlook_mail",
      "description": "搜索、阅读、起草、回复、转发、发送和整理邮件，列文件夹、标记已读／未读及移动。写信和回复先用 draft、reply_all（默认回复所有人，排除自己、重复地址和密送）、reply（仅回复发件人，用户明确要求时）或 forward 创建草稿，Cindy 会展示可编辑的草稿卡；get_draft/update_draft/delete_draft 读取、修改、删除草稿，send_draft 经 10 秒撤销倒计时发送最新卡片内容。不能直接 send。用户确认收件人和内容后才发送；发送成功仅表示微软接受请求，不代表送达；结果为 unknown 时先查邮箱，不要直接重试。read 不标记已读；回答中引用返回的 web_url 链接。仅支持微软云端邮箱。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "search",
              "read",
              "list_folders",
              "mark_read",
              "mark_unread",
              "move",
              "draft",
              "reply",
              "reply_all",
              "forward",
              "get_draft",
              "update_draft",
              "send_draft",
              "delete_draft",
              "send"
            ]
          },
          "account": {
            "type": "string",
            "description": "outlook_accounts 返回的账号 ID。发信前核对发件账号；省略则用选定区域的默认账号。"
          },
          "cloud": {
            "type": "string",
            "enum": [
              "global",
              "china"
            ],
            "description": "全球版／世纪互联中国区。明确 account 时自动识别区域；都不传使用设置页默认区域（初始 global）。"
          },
          "query": {
            "type": "string",
            "description": "search：Microsoft KQL 全文搜索，可写 from:person@example.test。不能与 from/subject/unread/since/before 混用；微软全文搜索最多返回 1000 封。",
            "maxLength": 1000
          },
          "from": {
            "type": "string",
            "description": "search：精确匹配发件邮箱。"
          },
          "subject": {
            "type": "string",
            "description": "search：主题包含文字；draft/update_draft：主题，允许空字符串。",
            "maxLength": 998
          },
          "unread": {
            "type": "boolean",
            "description": "search：true 未读，false 已读，省略不限制。"
          },
          "since": {
            "type": "string",
            "description": "search：包含起始时间，ISO 日期按 UTC，时间需含时区。"
          },
          "before": {
            "type": "string",
            "description": "search：不包含结束时间，ISO 日期按 UTC，时间需含时区。"
          },
          "folder": {
            "type": "string",
            "description": "search：指定文件夹；list_folders：列其子文件夹。省略分别为全部邮件／根文件夹。使用查询得到的 ID，或 inbox、sentitems、drafts 等微软固定名。"
          },
          "max_results": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "每页条数，默认 10，最多 50。"
          },
          "page_token": {
            "type": "string",
            "description": "上一页返回的 next_page_token，原样传回。同一 action、account、cloud；翻页时不要同时传筛选条件或 max_results。"
          },
          "message_id": {
            "type": "string",
            "description": "read/mark_read/mark_unread/move/reply/reply_all/forward：原始邮件 ID。移动后使用返回的新 ID。"
          },
          "target_folder": {
            "type": "string",
            "description": "move：目标文件夹 ID 或微软固定名。自定义文件夹先用 list_folders 查到 ID。"
          },
          "body_text": {
            "type": "string",
            "description": "draft/update_draft：纯文本正文；reply/reply_all/forward：引用上方的回复正文。允许空字符串，不能与 body_html 同时传。",
            "maxLength": 200000
          },
          "to": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 100
              }
            ],
            "description": "draft/update_draft/forward：to 邮箱地址数组或逗号／分号分隔文本，不带显示姓名。总收件人最多 100 个；forward 至少需要 to。"
          },
          "cc": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 100
              }
            ],
            "description": "draft/update_draft/forward：cc 邮箱地址数组或逗号／分号分隔文本，不带显示姓名。总收件人最多 100 个；forward 至少需要 to。"
          },
          "bcc": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 100
              }
            ],
            "description": "draft/update_draft/forward：bcc 邮箱地址数组或逗号／分号分隔文本，不带显示姓名。总收件人最多 100 个；forward 至少需要 to。"
          },
          "body_html": {
            "type": "string",
            "maxLength": 64000,
            "description": "draft/update_draft/reply/reply_all/forward：HTML 正文片段（不含 html/head/body），回复时放在引用上方。不能与 body_text 同时传。"
          },
          "draft_id": {
            "type": "string",
            "description": "get_draft/update_draft/send_draft/delete_draft：draft、reply、reply_all、forward 返回的 draft_id。"
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "outlook_read_message",
      "description": "只读读取 Outlook 网页邮件链接（含 cindy_account 绑定账号）用于 Cindy 原生阅读，返回当前邮件正文、附件及同一会话的邮件摘要。默认不标记已读；仅在用户明确打开或要求标记已读时传 markRead:true，只标记当前这封，返回 markReadResult.execution（not_executed/executed/unknown），unknown 时先在邮箱核对，不要直接重试。不修改草稿、不发送。展开会话中的其他邮件时读取其 url。",
      "parameters": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "description": "Outlook 网页邮件链接，例如 outlook_mail 返回的 web_url（https://outlook.office365.com/owa/?ItemID=…&cindy_account=…）。"
          },
          "account": {
            "type": "string",
            "description": "可选：outlook_accounts 返回的账号 ID；链接未绑定账号且连接了多个账号时必填。"
          },
          "markRead": {
            "type": "boolean",
            "description": "仅在用户明确打开邮件或要求标记已读时为 true；AI 读取和邻近预加载不传。"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    }
  ],
  "command": "outlook-mail",
  "launch": "on-demand",
  "settingsHtml": "settings.html",
  "author": "Cindy plugin contributor",
  "network": {
    "hosts": [
      "login.microsoftonline.com",
      "graph.microsoft.com",
      "login.chinacloudapi.cn",
      "microsoftgraph.chinacloudapi.cn"
    ],
    "secrets": [
      {
        "key": "outlook_global",
        "label": "微软账号（全球版）",
        "source": "oauth",
        "hint": "在插件详情页连接账号；企业是否需要管理员批准取决于租户策略。",
        "inject": {
          "header": "Authorization",
          "format": "Bearer {value}",
          "hosts": [
            "graph.microsoft.com"
          ]
        },
        "oauth": {
          "authorizeUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/authorize",
          "tokenUrl": "https://login.microsoftonline.com/common/oauth2/v2.0/token",
          "scopes": [
            "openid",
            "offline_access",
            "https://graph.microsoft.com/User.Read",
            "https://graph.microsoft.com/Mail.ReadWrite",
            "https://graph.microsoft.com/Mail.Send"
          ],
          "pkce": true,
          "redirectPort": 53687,
          "extraAuthorizeParams": {
            "prompt": "select_account"
          },
          "identity": {
            "url": "https://graph.microsoft.com/v1.0/me?$select=id,displayName,mail,userPrincipalName",
            "labelPath": "id",
            "displayTemplate": "{displayName} · {userPrincipalName}"
          },
          "clientId": "de0423c6-9670-4774-bdfd-47d6912a4781"
        }
      },
      {
        "key": "outlook_china",
        "label": "微软账号（世纪互联中国区）",
        "source": "oauth",
        "hint": "在插件详情页连接账号；企业是否需要管理员批准取决于租户策略。",
        "inject": {
          "header": "Authorization",
          "format": "Bearer {value}",
          "hosts": [
            "microsoftgraph.chinacloudapi.cn"
          ]
        },
        "oauth": {
          "authorizeUrl": "https://login.chinacloudapi.cn/organizations/oauth2/v2.0/authorize",
          "tokenUrl": "https://login.chinacloudapi.cn/organizations/oauth2/v2.0/token",
          "scopes": [
            "openid",
            "offline_access",
            "https://microsoftgraph.chinacloudapi.cn/User.Read",
            "https://microsoftgraph.chinacloudapi.cn/Mail.ReadWrite",
            "https://microsoftgraph.chinacloudapi.cn/Mail.Send"
          ],
          "pkce": true,
          "redirectPort": 53688,
          "extraAuthorizeParams": {
            "prompt": "select_account"
          },
          "identity": {
            "url": "https://microsoftgraph.chinacloudapi.cn/v1.0/me?$select=id,displayName,mail,userPrincipalName",
            "labelPath": "id",
            "displayTemplate": "{displayName} · {userPrincipalName}"
          }
        }
      }
    ]
  },
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json"
  },
  "setup": {
    "requires": []
  },
  "cindy": {
    "media": [
      "deposit"
    ]
  },
  "agent": {},
  "sessionContext": true,
  "mail": true,
  "mailReader": {
    "tool": "outlook_read_message",
    "hosts": [
      "outlook.office365.com",
      "outlook.office.com",
      "outlook.live.com",
      "outlook.cloud.microsoft",
      "partner.outlook.cn"
    ],
    "markRead": true
  }
}
