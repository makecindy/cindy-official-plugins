+    private var slot: Double?
+    private var repeatsLeft = 0
+    private(set) var settled = false
 
-    init(fps: Int, repeating: Bool) {
+    init(fps: Int, repeating: Bool, settleRepeats: Int? = nil) {
         self.fps = fps
         self.repeating = repeating
+        self.settleRepeats = settleRepeats.map { max(1, $0) }
+    }
+
+    private var interval: Double { 1.0 / Double(max(1, fps)) }
+
+    private var repeats: Bool {
+        repeating && latest != nil && (settleRepeats == nil || repeatsLeft > 0)
     }
 
     mutating func offer(_ frame: Frame) { pending = frame }
 
     func deadline(at now: Double) -> Double? {
-        guard pending != nil || (repeating && latest != nil) else { return nil }
-        guard let lastEmission else { return now }
-        return max(now, lastEmission + 1.0 / Double(max(1, fps)))
+        guard pending != nil || repeats else { return nil }
+        guard let slot else { return now }
+        return max(now, slot + interval)
     }
 
     mutating func take(at now: Double) -> Frame? {
         guard let deadline = deadline(at: now), now >= deadline,
-            let frame = pending ?? (repeating ? latest : nil)
+            let frame = pending ?? latest
         else { return nil }
+        let fresh = pending != nil
         pending = nil
         latest = frame
-        lastEmission = now
+        let next = slot.map { $0 + interval } ?? now
+        slot = now - next >= interval ? now : next
+        if fresh {
+            repeatsLeft = settleRepeats ?? 0
+            settled = false
+        } else if settleRepeats != nil {
+            repeatsLeft -= 1
+            settled = repeatsLeft == 0
+        }
         return frame
     }
 
+    /// Send the latest frame once more after the stream has settled, e.g.
+    /// when a client asks for a keyframe or the output scale changes.
