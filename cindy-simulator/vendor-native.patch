diff --git a/Tests/BaguetteTests/Stream/StreamFrameScheduleTests.swift b/Tests/BaguetteTests/Stream/StreamFrameScheduleTests.swift
index d5b82f2..3235918 100644
--- a/Tests/BaguetteTests/Stream/StreamFrameScheduleTests.swift
+++ b/Tests/BaguetteTests/Stream/StreamFrameScheduleTests.swift
@@ -87,6 +87,71 @@ struct StreamFrameScheduleTests {
         #expect(deadline.wait(timeout: .now() + 1) == .success)
         #expect(values.values.count == stoppedCount)
     }
+
+    @Test func `should keep the requested rate when every timer fires late`() {
+        var schedule = StreamFrameSchedule<Int>(fps: 60, repeating: false)
+        var now = 0.0, emitted = 0
+        while now < 1 {
+            schedule.offer(emitted)
+            guard let deadline = schedule.deadline(at: now) else { break }
+            now = deadline + 0.005  // dispatch timers wake a few ms late
+            if schedule.take(at: now) != nil { emitted += 1 }
+        }
+        #expect(emitted >= 59 && emitted <= 61)
+    }
+
+    @Test func `should restart the cadence instead of bursting after a long gap`() {
+        var schedule = StreamFrameSchedule<Int>(fps: 60, repeating: false)
+        schedule.offer(1)
+        _ = schedule.take(at: 0)
+        schedule.offer(2)
+        let late = schedule.take(at: 1)
+        #expect(late == 2)
+        schedule.offer(3)
+        #expect(schedule.deadline(at: 1) == 1 + 1.0 / 60)
+    }
+
+    @Test func `should stop repeating after the settle repeats and mark the last one`() {
+        var schedule = StreamFrameSchedule<Int>(fps: 60, repeating: true, settleRepeats: 3)
+        schedule.offer(5)
+        _ = schedule.take(at: 0)
+        var marks: [Bool] = []
+        var now = 0.0
+        while let deadline = schedule.deadline(at: now) {
+            now = deadline
+            #expect(schedule.take(at: now) == 5)
+            marks.append(schedule.settled)
+        }
+        #expect(marks == [false, false, true])
+        schedule.revive()
+        let revived = schedule.deadline(at: 1).flatMap { schedule.take(at: $0) }
+        #expect(revived == 5 && schedule.settled)
+        #expect(schedule.deadline(at: 2) == nil)
+        schedule.offer(6)
+        _ = schedule.take(at: 2)
+        #expect(!schedule.settled && schedule.deadline(at: 2) != nil)
+    }
+
+    @Test func `should hand the final repeat to the settle closure and then go quiet`() throws {
+        let delivered = PacedValues(), settled = PacedValues()
+        let queue = DispatchQueue(label: "frame-pump-settle-test")
+        let pump = StreamFramePump<Int>(
+            queue: queue, fps: 100, repeating: true, settleRepeats: 2,
+            deliver: { delivered.append($0) }, settle: { settled.append($0) }
+        )
+        pump.start()
+        pump.offer(1)
+        #expect(settled.changed.wait(timeout: .now() + 1) == .success)
+        #expect(delivered.values == [1, 1] && settled.values == [1])
+        let quiet = DispatchSemaphore(value: 0)
+        queue.asyncAfter(deadline: .now() + 0.1) { quiet.signal() }
+        #expect(quiet.wait(timeout: .now() + 1) == .success)
+        #expect(delivered.values.count == 2 && settled.values.count == 1)
+        pump.revive()
+        #expect(settled.changed.wait(timeout: .now() + 1) == .success)
+        #expect(settled.values == [1, 1] && delivered.values.count == 2)
+        pump.stop()
+    }
 }
 
