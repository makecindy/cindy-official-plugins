+// Read-only preview over the existing paired-device listener. Encode once on
+// the phone instead of PNG transfer plus synchronous JavaScript JPEG encoding.
++ (id<FBResponsePayload>)handleCindyFrame:(FBRouteRequest *)request
+{
+  long long displayID = [request.parameters[@"displayID"] longLongValue];
+  if (displayID < 1 || displayID > 1024) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"Invalid display ID" traceback:nil]);
+  }
+  NSError *error = nil;
+  NSData *data = [FBScreenshot takeInOriginalResolutionWithScreenID:displayID
+                                              compressionQuality:0.65
+                                                             uti:UTTypeJPEG
+                                                         timeout:5.0
+                                                           error:&error];
+  if (data == nil) {
+    return FBResponseWithStatus([FBCommandStatus unableToCaptureScreenErrorWithMessage:error.description traceback:nil]);
+  }
+  CGImageSourceRef source = CGImageSourceCreateWithData((__bridge CFDataRef)data, NULL);
+  NSDictionary *properties = source ? CFBridgingRelease(CGImageSourceCopyPropertiesAtIndex(source, 0, NULL)) : nil;
+  if (source) CFRelease(source);
+  CGFloat width = [properties[(__bridge NSString *)kCGImagePropertyPixelWidth] doubleValue];
+  CGFloat height = [properties[(__bridge NSString *)kCGImagePropertyPixelHeight] doubleValue];
+  if (width <= 0 || height <= 0) {
+    return FBResponseWithStatus([FBCommandStatus unableToCaptureScreenErrorWithMessage:@"Invalid preview dimensions" traceback:nil]);
+  }
+  CGFloat factor = MIN(1.0, 1280.0 / MAX(width, height));
+  data = [[FBImageProcessor new] scaledImageWithData:data uti:UTTypeJPEG
+                                     scalingFactor:factor compressionQuality:0.65 error:&error];
+  if (data == nil) {
+    return FBResponseWithStatus([FBCommandStatus unableToCaptureScreenErrorWithMessage:error.description traceback:nil]);
+  }
+  return FBResponseWithObject(@{@"image": [data base64EncodedStringWithOptions:(NSDataBase64EncodingOptions)0],
+                                @"width": @(width), @"height": @(height)});
+}
