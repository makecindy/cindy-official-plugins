++ (id<FBResponsePayload>)handleCindyKeyboardReady:(FBRouteRequest *)request
+{
+  NSError *error = nil;
+  BOOL ready = [[[FBRunLoopSpinner new] timeout:2.0] spinUntilTrue:^BOOL {
+    XCUIElement *key = [[[request.session.activeApplication descendantsMatchingType:XCUIElementTypeKey]
