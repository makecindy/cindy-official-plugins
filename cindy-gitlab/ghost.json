{
  "schemaVersion": 3,
  "id": "cindy-gitlab",
  "name": "GitLab",
  "description": "内置的 GitLab 服务插件:支持自建与多实例 GitLab——自动使用本机 glab 已登录的实例,也可在「插件」→「GitLab」详情页添加实例地址与 Personal Access Token(api scope,插件内添加的账号优先),即可读写 issue / MR / code review / 仓库 / CI / release / 搜索等 107 个操作。token 由主机保管,只注入对应实例的 API 请求。",
  "whenToUse": "只管 GitLab 实例(gitlab.com/公司/自建),github.com 的链接不归我、找 GitHub。需要查/建/改 GitLab issue 或 MR,提交/回复/发布 code review,合并或 rebase MR,查仓库/分支/commit/文件内容,查 CI pipeline 与 job 日志,管理 release / tag / 分支,搜索全实例内容,或下载仓库归档时找我(自动使用本机 glab 登录,也可在「插件」→「GitLab」详情页添加实例与 token)。",
  "version": "1.3.0",
  "minCindyVersion": "0.1.64",
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json"
  },
  "author": "Cindy",
  "icon": "assets/icon.png",
  "entry": "main.js",
  "settingsHtml": "settings.html",
  "notify": true,
  "fs": true,
  "command": "cindy-gitlab",
  "network": {
    "connections": [
      {
        "key": "gitlab_conn",
        "label": "GitLab 实例",
        "source": "glab-cli",
        "hint": "本机 glab 已登录的实例会自动使用;也可在下方单独添加实例地址与 PAT(api scope,插件里添加的账号优先)。仅支持 https 默认端口(443)",
        "inject": {
          "header": "PRIVATE-TOKEN",
          "format": "{value}"
        },
        "maxConnections": 8
      }
    ]
  },
  "routineEvents": {
    "events": [
      {
        "type": "merge_request.opened",
        "name": "MR 新建",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "sourceBranch", "targetBranch", "sha", "draft", "actor", "fromSelf"]
      },
      {
        "type": "merge_request.updated",
        "name": "MR 有新提交或更新",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "sourceBranch", "targetBranch", "sha", "draft", "changes"]
      },
      {
        "type": "merge_request.comment",
        "name": "MR 新评论",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "sourceBranch", "targetBranch", "sha", "draft", "actor", "fromSelf", "noteId", "body"]
      },
      {
        "type": "merge_request.approved",
        "name": "MR 被批准",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "sourceBranch", "targetBranch", "sha", "draft", "actor", "fromSelf", "noteId"]
      },
      {
        "type": "merge_request.pipeline",
        "name": "MR 流水线出结果",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "sourceBranch", "targetBranch", "sha", "draft", "pipelineId", "pipelineStatus"]
      },
      {
        "type": "merge_request.merged",
        "name": "MR 已合并",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "sourceBranch", "targetBranch", "sha", "draft", "actor", "fromSelf"]
      },
      {
        "type": "merge_request.closed",
        "name": "MR 已关闭",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "sourceBranch", "targetBranch", "sha", "draft", "actor", "fromSelf"]
      },
      {
        "type": "merge_request.reopened",
        "name": "MR 重新打开",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "sourceBranch", "targetBranch", "sha", "draft"]
      },
      {
        "type": "issue.opened",
        "name": "Issue 新建",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "actor", "fromSelf"]
      },
      {
        "type": "issue.updated",
        "name": "Issue 有更新",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "changes"]
      },
      {
        "type": "issue.comment",
        "name": "Issue 新评论",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "actor", "fromSelf", "noteId", "body"]
      },
      {
        "type": "issue.closed",
        "name": "Issue 已关闭",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels", "actor", "fromSelf"]
      },
      {
        "type": "issue.reopened",
        "name": "Issue 重新打开",
        "fields": ["host", "project", "iid", "kind", "state", "url", "author", "authorIsSelf", "labels"]
      }
    ]
  },
  "tools": [
    {
      "name": "list_tools",
      "description": "列出本插件可用的 GitLab 操作(共 107 个,覆盖 issues / merge_requests / repo / commits / events / search / projects / users / pipelines / jobs / discussions / approvals / draft_notes / reactions / groups / environments / wiki / snippets / releases / meta)。不传 category 返回类目概览(类目名+数量+说明);传 category 返回该类目下所有操作的名称、说明与参数。",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "类目名,来自概览(如 issues / merge_requests / pipelines)"
          }
        }
      }
    },
    {
      "name": "call_tool",
      "description": "执行一个具体 GitLab 操作。name 来自 list_tools 的返回;args 按该操作的参数说明传 JSON 对象。project 级操作必须显式传 project_path(如 \"group/subgroup/project\",在 git 仓库里工作时可从 `git remote get-url origin` 推导后传入)。配了多个 GitLab 实例时在 args 里带 instance(连接 id 或实例地址)指定实例,省略走默认连接。响应默认剥掉头像与 _links 字段以控制体量,传 raw=true 拿原始 JSON;结果超 50KB 时自动写进会话工作目录只返回文件路径(out_file 可指定路径)。下载类操作(仓库归档)需要调用方把目标目录绝对路径放在 ghost_call 顶层 save_dir 参数;上传项目附件(upload_project_file)需要用户随消息发图并经 ghost_call 顶层 attachments 过户。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "操作名,来自 list_tools"
          },
          "args": {
            "type": "object",
            "description": "操作参数;不确定时可传 {} 触发错误反馈拿参数说明"
          },
          "raw": {
            "type": "boolean",
            "description": "true = 返回 GitLab 原始 JSON(不剥头像 / _links 字段);默认 false"
          },
          "out_file": {
            "type": "string",
            "description": "可选:把完整结果 JSON 写进会话工作目录的该相对路径(如 tmp/gl-result.json),只返回文件路径——结果大、要交给脚本处理时用。结果超 50KB 时即使不传也会自动落盘返回路径"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  ]
}
