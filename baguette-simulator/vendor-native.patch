+import Foundation
+import Testing
+@testable import Baguette
+
+@Suite("DigitizerContacts")
+struct DigitizerContactsTests {
+    @Test func `should route every finger to the screen when a gesture contains two fingers`() {
+        let message = calloc(1, 512)!
+        defer { free(message) }
+        message.storeBytes(of: UInt32(160), toByteOffset: 0x18, as: UInt32.self)
+        message.storeBytes(of: UInt32(3), toByteOffset: 0x1c, as: UInt32.self)
+        IOHIDDigitizerDispatch.patch(message: message, edge: .none)
+        for offset in [0x6c, 0x10c, 0x1ac] {
+            #expect(message.load(fromByteOffset: offset, as: UInt32.self) == IndigoHIDTouchTarget.phone)
+        }
+    }
+
+    @Test func `should preserve the screen edge for every finger when a gesture starts at an edge`() {
+        let message = calloc(1, 512)!
+        defer { free(message) }
+        message.storeBytes(of: UInt32(160), toByteOffset: 0x18, as: UInt32.self)
+        message.storeBytes(of: UInt32(3), toByteOffset: 0x1c, as: UInt32.self)
+        IOHIDDigitizerDispatch.patch(message: message, edge: .bottom)
+        for offset in [0x3a, 0xda, 0x17a] {
+            #expect(message.load(fromByteOffset: offset, as: UInt8.self) == 0x04)
+            #expect(message.load(fromByteOffset: offset + 1, as: UInt8.self) == 0x01)
+        }
+    }
+    @Test(arguments: [(UInt32(159), UInt32(3)), (160, 4), (160, 0)])
+    func `should leave an invalid touch message unchanged when its layout is unsupported`(layout: (UInt32, UInt32)) {
+        let message = calloc(1, 512)!
+        defer { free(message) }
+        message.storeBytes(of: layout.0, toByteOffset: 0x18, as: UInt32.self)
+        message.storeBytes(of: layout.1, toByteOffset: 0x1c, as: UInt32.self)
+        #expect(!IOHIDDigitizerDispatch.patch(message: message, edge: .bottom))
+        #expect(message.load(fromByteOffset: 0x6c, as: UInt32.self) == 0)
+    }
+
+    @Test func `should leave unused capacity untouched when a message contains one finger`() {
+        let message = calloc(1, 512)!
+        defer { free(message) }
+        message.storeBytes(of: UInt32(160), toByteOffset: 0x18, as: UInt32.self)
+        message.storeBytes(of: UInt32(2), toByteOffset: 0x1c, as: UInt32.self)
+        #expect(IOHIDDigitizerDispatch.patch(message: message, edge: .none))
+        #expect(message.load(fromByteOffset: 0x1ac, as: UInt32.self) == 0)
+    }
+
+}

