+import NIOCore
+import NIOPosix
+import Testing
+@testable import Baguette
+
+@Suite("InteractiveSocket")
+struct InteractiveSocketTests {
+    @Test func `should send small interactive updates immediately when a connection opens`() async throws {
+        let group = MultiThreadedEventLoopGroup(numberOfThreads: 1)
+        defer { group.shutdownGracefully { _ in } }
+        let accepted = group.next().makePromise(of: (any Channel).self)
+        let server = try await ServerBootstrap(group: group)
+            .childChannelInitializer { channel in
+                channel.pipeline.addHandler(ImmediateSocketWrites()).map { accepted.succeed(channel) }
+            }
+            .bind(host: "127.0.0.1", port: 0).get()
+        defer { server.close(promise: nil) }
+        let address = try #require(server.localAddress)
+        let client = try await ClientBootstrap(group: group).connect(to: address).get()
+        defer { client.close(promise: nil) }
+        let connection = try await accepted.futureResult.get()
+        defer { connection.close(promise: nil) }
+        let immediate = try await connection.getOption(ChannelOptions.socketOption(.tcp_nodelay)).get()
+        #expect(immediate == 1)
+    }
+}
