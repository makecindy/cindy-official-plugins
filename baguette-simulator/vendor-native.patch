+// Read the runtime sensor inside custom device sets, which CoreDevice cannot discover.
+static int monitorAngle(double timeout) {
+  dlopen("/System/Library/Frameworks/CoreMotion.framework/CoreMotion", RTLD_NOW);
+  Class cls = NSClassFromString(@"CMAngleManager");
+  SEL available = sel_registerName("isAvailable");
+  if (!cls || ![cls respondsToSelector:available] || !((BOOL (*)(id, SEL))objc_msgSend)(cls, available)) return 3;
+  id manager = [cls new];
+  SEL start = sel_registerName("startAngleUpdatesToQueue:handler:");
+  if (![manager respondsToSelector:start]) return 3;
+  void (^handler)(id) = ^(id angle) {
+    if (![angle respondsToSelector:sel_registerName("isAngleValid")] ||
+        !((BOOL (*)(id, SEL))objc_msgSend)(angle, sel_registerName("isAngleValid"))) return;
+    float value = ((float (*)(id, SEL))objc_msgSend)(angle, sel_registerName("angleDegrees"));
+    if (isfinite(value)) { printf("Angle:%.3f° AngleValid:Y\n", value); fflush(stdout); }
+  };
+  ((void (*)(id, SEL, id, id))objc_msgSend)(manager, start, [NSOperationQueue mainQueue], handler);
+  [[NSRunLoop currentRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:timeout]];
+  ((void (*)(id, SEL))objc_msgSend)(manager, sel_registerName("stopAngleUpdates"));
+  return 0;
+}
+
