+import NIOCore
+import NIOHTTP1
+
+/// Interactive input and small H.264 delta frames must not wait for Nagle's
+/// packet batching and the peer's delayed ACK. The setting survives HTTP upgrade.
+final class ImmediateSocketWrites: ChannelInboundHandler, RemovableChannelHandler, Sendable {
+    typealias InboundIn = HTTPServerRequestPart
+    func handlerAdded(context: ChannelHandlerContext) {
+        let channel = context.channel
+        channel.setOption(ChannelOptions.socketOption(.tcp_nodelay), value: 1)
+            .whenFailure { _ in channel.close(promise: nil) }
+    }
+}
