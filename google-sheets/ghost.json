{
  "schemaVersion": 2,
  "id": "google-sheets",
  "name": "Google Sheets",
  "description": "独立连接 Google Sheets：读取工作表、读取范围并写入单元格。只申请 Sheets 所需权限，授权与令牌由主机托管。",
  "whenToUse": "需要读取或更新 Google Sheets 表格数据时使用。请先在本插件详情页单独连接 Google Sheets 账号。",
  "version": "1.1.2",
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json"
  },
  "author": "Cindy",
  "icon": "assets/icon.png",
  "entry": "main.js",
  "settingsHtml": "settings.html",
  "slots": ["tool", "network"],
  "command": "google-sheets",
  "network": {
    "hosts": [
      "accounts.google.com",
      "oauth2.googleapis.com",
      "www.googleapis.com",
      "sheets.googleapis.com"
    ],
    "secrets": [
      {
        "key": "google_sheets_account",
        "label": "Google Sheets 账号",
        "source": "oauth",
        "hint": "只授权 Google Sheets 权限；到本插件详情页点「连接账号」完成授权",
        "inject": {
          "header": "Authorization",
          "format": "Bearer {value}",
          "hosts": ["www.googleapis.com", "sheets.googleapis.com"]
        },
        "oauth": {
          "authorizeUrl": "https://accounts.google.com/o/oauth2/v2/auth",
          "tokenUrl": "https://oauth2.googleapis.com/token",
          "clientId": "966060737739-d3dfjdsaace1ur4thk03h3aj4hpnjucq.apps.googleusercontent.com",
          "clientSecret": "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",
          "scopes": [
            "openid",
            "https://www.googleapis.com/auth/userinfo.email",
            "https://www.googleapis.com/auth/spreadsheets"
          ],
          "pkce": true,
          "extraAuthorizeParams": {
            "access_type": "offline",
            "prompt": "consent"
          },
          "identity": {
            "url": "https://www.googleapis.com/oauth2/v3/userinfo",
            "labelPath": "email"
          }
        }
      }
    ]
  },
  "tools": [
    {
      "name": "google_sheets_accounts",
      "description": "列出本插件已连接的 Google Sheets 账号及状态。账号必须先在 Google Sheets 插件详情页单独授权。",
      "parameters": { "type": "object", "properties": {} }
    },
    {
      "name": "google_sheets",
      "description": "执行 Google Sheets 操作：list_sheets、read_range、write_range。写入单元格必须先向用户展示目标范围与内容并获得确认。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": ["list_sheets", "read_range", "write_range"]
          },
          "account": { "type": "string" },
          "spreadsheet_id": { "type": "string", "description": "表格 id 或完整 Google Sheets 链接" },
          "range": { "type": "string", "description": "A1 记法，例如 Sheet1!A1:D20" },
          "values": {
            "type": "array",
            "items": { "type": "array", "items": {} },
            "description": "write_range 使用的二维数组"
          }
        },
        "required": ["action", "spreadsheet_id"]
      }
    }
  ]
}
