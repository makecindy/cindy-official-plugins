{
  "manifest_version": 3,
  "name": "My Browser · Cindy",
  "description": "Connect your browser to Cindy. Fast signed-in reading; interaction requires site permission in Cindy.",
  "version": "0.3.35",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["tabs", "scripting", "storage", "alarms", "webRequest", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_title": "My Browser · Cindy", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}
}
