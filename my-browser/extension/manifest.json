{
  "manifest_version": 3,
  "name": "Cindy",
  "description": "Cindy: bilingual webpages, video subtitles, PDF reading and learning, together with browser control through Cindy.",
  "version": "0.4.23",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "webNavigation",
    "dns",
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Cindy",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "learning-core.js",
        "subtitle-playback.js",
        "ui.js",
        "reading-ui.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "translate-page": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Toggle bilingual webpage translation"
    },
    "open-cindy": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open Cindy on this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/48.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
