{
  "schemaVersion": 2,
  "id": "cindy-web-search",
  "name": "Web Search",
  "description": "Cindy 内置的网页搜索插件:默认使用 Cindy AI 搜索,也可用你自己的 Brave / Tavily key 搜索公网。key 在主界面侧边栏「插件」→「Web Search」详情页填写,加密存本机、只注入声明域名的请求。",
  "whenToUse": "需要搜索公网信息、查资料、找网页、看最新动态时找我(默认使用 Cindy AI 搜索,也可在主界面侧边栏「插件」→「Web Search」详情页配置 Brave 或 Tavily key)。",
  "version": "1.3.2",
  "minCindyVersion": "0.1.37",
  "locales": {
    "en": "locales/en.json",
    "zh-CN": "locales/zh-CN.json",
    "ja": "locales/ja.json",
    "ko": "locales/ko.json"
  },
  "author": "Cindy",
  "icon": "assets/icon.png",
  "entry": "main.js",
  "settingsHtml": "settings.html",
  "slots": ["tool", "cindy", "network"],
  "command": "cindy-web-search",
  "cindy": {
    "search": ["web"]
  },
  "network": {
    "hosts": ["api.search.brave.com", "api.tavily.com"],
    "secrets": [
      {
        "key": "brave_api_key",
        "label": "Brave Search API Key",
        "hint": "免费档即可(BSA 开头)",
        "url": "https://api-dashboard.search.brave.com/app/keys",
        "inject": {
          "header": "X-Subscription-Token",
          "format": "{value}",
          "hosts": ["api.search.brave.com"]
        }
      },
      {
        "key": "tavily_api_key",
        "label": "Tavily API Key",
        "hint": "tvly- 开头",
        "url": "https://app.tavily.com/home",
        "inject": {
          "header": "Authorization",
          "format": "Bearer {value}",
          "hosts": ["api.tavily.com"]
        }
      }
    ]
  },
  "setup": {
    "requires": []
  },
  "tools": [
    {
      "name": "search_web",
      "description": "搜索公网并返回结果列表(标题/链接/摘要)，查询最多 2000 字符。默认使用 Cindy AI 搜索;也可指定 Brave 或 Tavily。返回 JSON:{ provider, results: [{ title, url, snippet }] }。使用 Brave / Tavily 但对应 key 未配置时会返回指引,把 message 原样告诉用户即可。",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "maxLength": 2000, "description": "搜索关键词(用户原话意图,不要扩写,最多 2000 字符)" },
          "provider": { "type": "string", "enum": ["cindy", "brave", "tavily"], "description": "指定搜索源;通常省略(默认使用 Cindy AI 搜索)" },
          "limit": { "type": "number", "description": "结果条数,默认 5,最大 10" }
        },
        "required": ["query"]
      }
    }
  ]
}
