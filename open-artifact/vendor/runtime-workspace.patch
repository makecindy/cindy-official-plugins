+  const alias = join(work, 'alias');
+  mkdirSync(target);
+  symlinkSync(target, alias, 'junction');
+  const files = new WorkspaceDirectory(work);
+  assert.equal(files.resolve('alias'), target);
+  assert.equal(files.resolve('alias', false), alias);
+});
