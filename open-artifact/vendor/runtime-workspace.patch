+  assert.throws(() => files.resolve('draft.md'), { code: 'not_granted' });
+});
+
+test('replacing an entry preserves the meaning of an authorized in-workspace link', () => {
+  const work = realpathSync(mkdtempSync(join(tmpdir(), 'oa-workspace-entry-')));
